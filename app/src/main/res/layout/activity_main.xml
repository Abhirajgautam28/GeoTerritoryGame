<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- FULLSCREEN MAP -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- NEON TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_margin="12dp"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/neon_glass_panel"
        android:elevation="10dp">

        <ImageView
            android:id="@+id/icProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_avatar_glow"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvSteps"
                android:text="STEPS: 0"
                android:textColor="@color/neon_cyan"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDistance"
                android:text="DISTANCE: 0m"
                android:textColor="@color/white_80"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvArea"
                android:text="AREA: 0 m²"
                android:textColor="@color/white_80"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>


    <!-- NEON BOTTOM CONTROLS -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/neon_glass_panel"
        android:padding="12dp"
        android:elevation="10dp">

        <Button
            android:id="@+id/btnStart"
            style="@style/NeonButton"
            android:text="START WALK"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="12dp" />

        <Button
            android:id="@+id/btnStop"
            style="@style/NeonButton"
            android:text="STOP"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp" />

    </LinearLayout>


    <!-- NEON FLOATING ACTION BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDetails"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_layers_glow"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="150dp"
        app:tint="@color/neon_purple"
        app:backgroundTint="@android:color/transparent"
        android:background="@drawable/neon_fab_glow" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
