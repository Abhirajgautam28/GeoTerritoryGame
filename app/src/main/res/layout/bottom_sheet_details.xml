<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/neon_bottom_sheet_bg">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:text="WALK SUMMARY"
        android:textSize="22sp"
        android:textColor="@color/neon_cyan"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvSheetDistance"
        android:text="Distance: 0m"
        android:textColor="@color/white_80"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSheetArea"
        android:text="Area: 0 m²"
        android:textColor="@color/white_80"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCloseSheet"
        style="@style/NeonButtonSmall"
        android:text="CLOSE" />

</LinearLayout>
